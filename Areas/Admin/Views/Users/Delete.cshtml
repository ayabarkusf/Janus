@model Janus.ViewModels.Admin.Users.DeleteModel
@{
    ViewData["Title"] = "Deactivate User";
}

<div class="page-header"><div class="container"><h1>Deactivate User</h1><p>This hides the user without breaking historical data.</p></div></div>

<section class="section-pad"><div class="container">
@if (Model.ManagedUser != null)
{
    <div class="card-janus">
        <h2>@Model.ManagedUser.DisplayName</h2>
        <p>@Model.ManagedUser.Email</p>
        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="UserId" />
            <button type="submit" class="btn-secondary-janus">Deactivate User</button>
            <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="btn-outline-teal">Cancel</a>
        </form>
    </div>
}
</div></section>
