@model Janus.ViewModels.Admin.Users.IndexModel
@{
    ViewData["Title"] = "Manage Users";
}

<div class="page-header"><div class="container"><h1>Manage Users</h1><p>Admin-only user management.</p></div></div>

<section class="section-pad">
    <div class="container">
        <div class="table-responsive">
            <table class="table table-janus">
                <thead><tr><th>Name</th><th>Email</th><th>Student Role</th><th>Host Role</th><th>Admin Role</th><th>Active</th><th></th></tr></thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td>@user.DisplayName</td>
                            <td>@user.Email</td>
                            <td>@(user.IsStudent ? "Yes" : "No")</td>
                            <td>@(user.IsHost ? "Yes" : "No")</td>
                            <td>@(user.IsAdmin ? "Yes" : "No")</td>
                            <td>@(user.IsActive ? "Yes" : "No")</td>
                            <td class="text-nowrap">
                                <a asp-area="Admin" asp-controller="Users" asp-action="Details" asp-route-id="@user.Id" class="btn-outline-teal btn-sm">Details</a>
                                <a asp-area="Admin" asp-controller="Users" asp-action="Edit" asp-route-id="@user.Id" class="btn-outline-teal btn-sm">Edit</a>
                                <a asp-area="Admin" asp-controller="Users" asp-action="Delete" asp-route-id="@user.Id" class="btn-secondary-janus btn-sm">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
