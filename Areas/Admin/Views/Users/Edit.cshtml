@model Janus.ViewModels.Admin.Users.EditModel
@{
    ViewData["Title"] = "Edit User";
}

<div class="page-header"><div class="container"><h1>Edit User</h1><p>Admin-only user editing.</p></div></div>

<section class="section-pad">
<div class="container">
<div class="card-janus">
<form method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Input.Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row">
        <div class="col-md-6 mb-3"><label asp-for="Input.FirstName" class="form-label"></label><input asp-for="Input.FirstName" class="form-control" /></div>
        <div class="col-md-6 mb-3"><label asp-for="Input.LastName" class="form-label"></label><input asp-for="Input.LastName" class="form-control" /></div>
    </div>
    <div class="mb-3"><label asp-for="Input.City" class="form-label"></label><input asp-for="Input.City" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Input.Company" class="form-label"></label><input asp-for="Input.Company" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Input.Industry" class="form-label"></label><input asp-for="Input.Industry" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Input.GradeLevel" class="form-label"></label><input asp-for="Input.GradeLevel" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Input.CareerInterest" class="form-label"></label><input asp-for="Input.CareerInterest" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Input.Bio" class="form-label"></label><textarea asp-for="Input.Bio" class="form-control"></textarea></div>

    <div class="form-check"><input asp-for="Input.IsStudent" class="form-check-input" /><label asp-for="Input.IsStudent" class="form-check-label"></label></div>
    <div class="form-check"><input asp-for="Input.IsHost" class="form-check-input" /><label asp-for="Input.IsHost" class="form-check-label"></label></div>
    <div class="form-check"><input asp-for="Input.IsAdmin" class="form-check-input" /><label asp-for="Input.IsAdmin" class="form-check-label"></label></div>
    <div class="form-check mb-4"><input asp-for="Input.IsActive" class="form-check-input" /><label asp-for="Input.IsActive" class="form-check-label"></label></div>

    <button type="submit" class="btn-primary-janus">Save</button>
    <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="btn-outline-teal">Cancel</a>
</form>
</div>
</div>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
