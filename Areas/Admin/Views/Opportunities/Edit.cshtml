@model Janus.ViewModels.Admin.Opportunities.EditModel
@{
    ViewData["Title"] = "Edit Opportunity";
}

<div class="page-header"><div class="container"><h1>Edit Opportunity</h1><p>Admin edit.</p></div></div>

<section class="section-pad"><div class="container"><div class="card-janus">
<form method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Opportunity.Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3"><label asp-for="Opportunity.HostUserId" class="form-label">Host</label><select asp-for="Opportunity.HostUserId" asp-items="Model.HostOptions" class="form-select"></select></div>
    <div class="mb-3"><label asp-for="Opportunity.Title" class="form-label"></label><input asp-for="Opportunity.Title" class="form-control" /></div>
    <div class="mb-3">
        <label asp-for="Opportunity.Industry" class="form-label"></label>
        <select asp-for="Opportunity.Industry" class="form-select">
            @foreach (var industry in Model.Industries)
            {
                <option value="@industry">@industry</option>
            }
        </select>
    </div>
    <div class="mb-3"><label asp-for="Opportunity.City" class="form-label"></label><input asp-for="Opportunity.City" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Opportunity.SkillsTaught" class="form-label"></label><input asp-for="Opportunity.SkillsTaught" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Opportunity.Description" class="form-label"></label><textarea asp-for="Opportunity.Description" class="form-control"></textarea></div>
    <div class="form-check"><input asp-for="Opportunity.IsOpen" class="form-check-input" /><label asp-for="Opportunity.IsOpen" class="form-check-label">Open</label></div>
    <div class="form-check mb-4"><input asp-for="Opportunity.IsActive" class="form-check-input" /><label asp-for="Opportunity.IsActive" class="form-check-label">Active</label></div>
    <button type="submit" class="btn-primary-janus">Save</button>
    <a asp-area="Admin" asp-controller="Opportunities" asp-action="Index" class="btn-outline-teal">Cancel</a>
</form>
</div></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
