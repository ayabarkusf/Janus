@model Janus.ViewModels.Admin.Opportunities.DetailsModel
@{
    ViewData["Title"] = "Opportunity Details";
}

<div class="page-header"><div class="container"><h1>Opportunity Details</h1><p>Admin view.</p></div></div>
<section class="section-pad"><div class="container">
@if (Model.Opportunity != null)
{
    <div class="card-janus">
        <h2>@Model.Opportunity.Title</h2>
        <p><strong>Host:</strong> @Model.Opportunity.HostUser?.DisplayName</p>
        <p><strong>Industry:</strong> @Model.Opportunity.Industry</p>
        <p><strong>City:</strong> @Model.Opportunity.City</p>
        <p><strong>Skills:</strong> @Model.Opportunity.SkillsTaught</p>
        <p><strong>Description:</strong> @Model.Opportunity.Description</p>
        <p><strong>Open:</strong> @Model.Opportunity.IsOpen</p>
        <p><strong>Active:</strong> @Model.Opportunity.IsActive</p>
        <a asp-area="Admin" asp-controller="Opportunities" asp-action="Edit" asp-route-id="@Model.Opportunity.Id" class="btn-primary-janus">Edit</a>
        <a asp-area="Admin" asp-controller="Opportunities" asp-action="Index" class="btn-outline-teal">Back</a>
    </div>
}
</div></section>
