@model Janus.ViewModels.Admin.IndexModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="page-header"><div class="container"><h1>Admin Dashboard</h1><p>Manage Janus users, opportunities and applications.</p></div></div>

<section class="section-pad">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-3"><div class="card-janus text-center"><h3>Total Users</h3><h2>@Model.TotalUsers</h2></div></div>
            <div class="col-md-3"><div class="card-janus text-center"><h3>Students</h3><h2>@Model.TotalStudents</h2></div></div>
            <div class="col-md-3"><div class="card-janus text-center"><h3>Hosts</h3><h2>@Model.TotalHosts</h2></div></div>
            <div class="col-md-3"><div class="card-janus text-center"><h3>Applications</h3><h2>@Model.TotalApplications</h2></div></div>
        </div>

        <div class="card-janus mt-4">
            <div class="d-flex flex-wrap gap-2">
                <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="btn-primary-janus">Manage Users</a>
                <a asp-area="Admin" asp-controller="Opportunities" asp-action="Index" class="btn-outline-teal">Manage Opportunities</a>
                <a asp-area="Admin" asp-controller="Applications" asp-action="Index" class="btn-secondary-janus">Manage Applications</a>
            </div>
        </div>
    </div>
</section>
