@model Janus.ViewModels.Users.MyProfileModel
@{
    ViewData["Title"] = "My Profile";
    var isStudent = User.IsInRole(AppConstants.StudentRole) || (Model.CurrentUser?.IsStudent == true);
    var isHost = User.IsInRole(AppConstants.HostRole) || (Model.CurrentUser?.IsHost == true);
    var isAdmin = User.IsInRole(AppConstants.AdminRole);
}

<div class="page-header"><div class="container"><h1>My Profile</h1><p>Manage your Janus account and profile access.</p></div></div>

<section class="section-pad">
    <div class="container">
        @if (Model.CurrentUser != null)
        {
            <div class="card-janus">
                <h2>@Model.CurrentUser.DisplayName</h2>
                <p><strong>Email:</strong> @Model.CurrentUser.Email</p>
                @if (!string.IsNullOrEmpty(Model.CurrentUser.PhoneNumber))
                {
                    <p><strong>Phone:</strong> @Model.CurrentUser.PhoneNumber</p>
                }
                <p><strong>City:</strong> @Model.CurrentUser.City</p>

                <div class="d-flex flex-wrap gap-2 my-4">
                    @if (isStudent) { <span class="profile-badge">Student</span> }
                    @if (isHost) { <span class="profile-badge">Host</span> }
                    @if (isAdmin) { <span class="profile-badge">Admin</span> }
                </div>

                @if (isStudent)
                {
                    <p><strong>Grade:</strong> @Model.CurrentUser.GradeLevel</p>
                    <p><strong>Career Interest:</strong> @Model.CurrentUser.CareerInterest</p>
                }

                @if (isHost)
                {
                    <p><strong>Company:</strong> @Model.CurrentUser.Company</p>
                    <p><strong>Industry:</strong> @Model.CurrentUser.Industry</p>
                    <p><strong>Bio:</strong> @Model.CurrentUser.Bio</p>
                }

                <div class="d-flex flex-wrap gap-2 mt-4">
                    <a asp-controller="Users" asp-action="EditProfile" class="btn-primary-janus">Edit Profile</a>
                    @if (isStudent)
                    {
                        <a asp-controller="Applications" asp-action="MyApplications" class="btn-outline-teal">My Applications</a>
                    }
                    @if (isHost)
                    {
                        <a asp-controller="Opportunities" asp-action="MyOpportunities" class="btn-outline-teal">My Opportunities</a>
                    }
                    @if (isAdmin)
                    {
                        <a asp-area="Admin" asp-controller="Admin" asp-action="Index" class="btn-secondary-janus">Admin Dashboard</a>
                    }
                    <a asp-controller="Users" asp-action="DeleteAccount" class="btn-outline-teal">Delete Account</a>
                </div>
            </div>
        }
    </div>
</section>
