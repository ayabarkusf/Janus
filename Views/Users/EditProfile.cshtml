@model Janus.ViewModels.Users.EditProfileModel
@{
    ViewData["Title"] = "Edit Profile";
}

<div class="page-header"><div class="container"><h1>Edit Profile</h1><p>Update your account information.</p></div></div>

<section class="section-pad">
    <div class="container">
        <div class="card-janus">
            <form method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.FirstName" class="form-label"></label>
                        <input asp-for="Input.FirstName" class="form-control" />
                        <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.LastName" class="form-label"></label>
                        <input asp-for="Input.LastName" class="form-control" />
                        <span asp-validation-for="Input.LastName" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.PhoneNumber" class="form-label"></label>
                    <input asp-for="Input.PhoneNumber" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Input.City" class="form-label"></label>
                    <input asp-for="Input.City" class="form-control" />
                    <span asp-validation-for="Input.City" class="text-danger"></span>
                </div>

                @if (Model.IsStudent)
                {
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.GradeLevel" class="form-label"></label>
                            <select asp-for="Input.GradeLevel" class="form-select">
                                <option value="">Select grade</option>
                                @foreach (var grade in Model.GradeLevels)
                                {
                                    <option value="@grade">@grade</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.CareerInterest" class="form-label"></label>
                            <select asp-for="Input.CareerInterest" class="form-select">
                                <option value="">Select interest</option>
                                @foreach (var industry in Model.Industries)
                                {
                                    <option value="@industry">@industry</option>
                                }
                            </select>
                        </div>
                    </div>
                }

                @if (Model.IsHost)
                {
                    <div class="mb-3">
                        <label asp-for="Input.Company" class="form-label"></label>
                        <input asp-for="Input.Company" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Industry" class="form-label"></label>
                        <select asp-for="Input.Industry" class="form-select">
                            <option value="">Select industry</option>
                            @foreach (var industry in Model.Industries)
                            {
                                <option value="@industry">@industry</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Bio" class="form-label"></label>
                        <textarea asp-for="Input.Bio" class="form-control" rows="4"></textarea>
                    </div>
                }

                <div class="d-flex flex-wrap gap-2 mt-4">
                    <button type="submit" class="btn-primary-janus">Save</button>
                    <a asp-controller="Users" asp-action="MyProfile" class="btn-outline-teal">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
