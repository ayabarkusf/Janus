@model Janus.ViewModels.BotModel
@{
    ViewData["Title"] = "Ask Janus AI";
}

<div class="page-header">
    <div class="container">
        <h1>Meet Janus AI</h1>
        <p>Your personal career guide for shadow opportunities and platform questions.</p>
    </div>
</div>

<section class="section-pad">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7">
                <div class="card-janus">
                    <h2 class="form-section-title">What Janus AI Knows</h2>
                    <p class="form-section-sub">The bot is available on every page through the shared layout.</p>
                    <p class="mt-3">
                        Ask Janus AI what the platform does, how students apply, how hosts create opportunities
                        and what industries are currently supported.
                    </p>
                    <p>
                        The bot should answer general platform questions. Live opportunity and application data
                        should come from the website itself.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-pad-sm">
    <div class="container">
        <div class="text-center mb-4">
            <h2 class="section-title">Try Asking</h2>
        </div>
        <div class="row g-3">
            <div class="col-lg-6"><div class="card-janus"><p class="bot-question">“What is Janus?”</p></div></div>
            <div class="col-lg-6"><div class="card-janus"><p class="bot-question">“How do students apply?”</p></div></div>
            <div class="col-lg-6"><div class="card-janus"><p class="bot-question">“How can I become a host?”</p></div></div>
            <div class="col-lg-6"><div class="card-janus"><p class="bot-question">“Which industries does Janus support?”</p></div></div>
        </div>
    </div>
</section>
